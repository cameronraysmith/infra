.DS_Store
.direnv
.env
.secrets.env
result*
external-references
.obsidian
.pre-commit-config.yaml
node_modules/
# Anchored: an unanchored `archive/` also matches openspec/changes/archive/,
# whose archived change artifacts must stay tracked.
/archive/

# TypeScript/npm build artifacts
dist/
apm_modules/
# .agents/skills/ is regenerated from apm.yml + apm.lock.yaml.
.agents/
build/
.astro/
coverage/
test-results/
playwright-report/

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python bytecode
__pycache__/
*.pyc

# wrangler (Cloudflare Workers)
.wrangler/
.dev.vars*
!.dev.vars.example

# Bisect state files
.bisect-nixpkgs-state
.flake.lock.bisect-backup

# Workspace manifest generated artifacts (CUE is source of truth)
manifests/workspace-manifest.json
manifests/workspace-manifest.yaml

# Terraform generated files (tfstate is encrypted via PBKDF2, safe for git)
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/config.tf.json
terraform/.terraform-deploy-key
terraform/.gcp-terraform-deploy-key
terraform/result

# Deployment logs
*.log
logs/
secrets/home-manager.backup-pre-2.4/

# bv (beads viewer) local config and caches
.bv/

# Git worktree checkout directories
.worktrees/

# Beads / Dolt files (added by bd init)
.beads/*
!.beads/.keep
.dolt/
*.db
.beads-credential-key

# Agent context files: generated per-machine or symlinked from elsewhere, never committed here
CLAUDE.md
AGENTS.md
GEMINI.md
SOUL.md
CRUSH.md

# OpenWiki run state. The wiki is refreshed from a workstation by
# `just openwiki-refresh`, not from CI, so these are per-clone run state
# rather than shared repository state. `.run.json` is resumable state for an
# interrupted run and upstream's own workflow deletes it before committing.
# If a refresh ever runs in CI, these must become tracked so the run can tell
# which commit it last documented.
openwiki/.run.json
openwiki/.last-update.json
openwiki/.page-manifest.json
openwiki/.claims/
